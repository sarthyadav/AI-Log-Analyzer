# Virtual environment - this is machine-specific, huge, and never belongs in git.
# Anyone cloning the repo creates their own with venv + requirements.txt
venv/

# Environment variables / secrets - NEVER commit API keys
.env

# Python cache files - auto-generated bytecode, not source code
__pycache__/
*.pyc

# IDE-specific settings - personal to your editor, not the project
.idea/

# OS junk files
.DS_Store